# FastAPI Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-backend.onrender.com,localhost,127.0.0.1

# Database (Render provides DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Frontend URL (your Vercel deployment URL)
FRONTEND_URL=https://your-frontend.vercel.app

# JWT Settings
ACCESS_TOKEN_EXPIRE_HOURS=1
REFRESH_TOKEN_EXPIRE_DAYS=7

# Super Admin Setup (for initial setup only)
SUPERADMIN_SETUP_SECRET=your-setup-secret-here
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=Admin@123

# Timezone
TIMEZONE=Asia/Kolkata

# Email Settings (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@attendease.com